# ============================================================================
# VARIABLES D'ENVIRONNEMENT - SECU GUARD
# ============================================================================
# Copiez ce fichier en .env et renseignez les valeurs de votre environnement.
# Ne placez jamais une clé secrète ou service_role dans ce fichier.

# Supabase (valeurs publiques)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optionnel — à confirmer avant utilisation
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_EXPO_PROJECT_ID=

